# Copy to .env and fill in values. Used both by `uvicorn api.main:app`
# and by `docker compose up` (loaded via env_file) — no extra variables
# are needed for containerized use.
# --- Provider selection ---
# Which maps backend to use: "osm" (free, no key, works immediately) or "google" (paid, requires billing + key below)
MAPS_PROVIDER=osm


# Only required when MAPS_PROVIDER=google
# Get from Google Cloud Console: APIs & Services > Credentials.
# Restrict this key: API restrictions = Places API, Geocoding API,
# Directions API, Maps Embed API only; plus IP restriction to your server.
# Set a budget alert / daily quota cap in Google Cloud Console (manual step,
# not enforced by code).
GOOGLE_MAPS_API_KEY=

# --- Backend API ---
# Base URL the Open WebUI Tool uses to reach this backend.
BACKEND_API_URL=http://localhost:8000
# Port/host for uvicorn (informational; not read by code unless you wire it).
HOST=127.0.0.1
PORT=8000

# --- Tunables ---
# Timeout (seconds) for outbound Google Maps requests.
MAPS_REQUEST_TIMEOUT_SECONDS=10
# Max results returned per search (normalized list truncation).
MAX_RESULTS=5

# --- Rate limiting (backend layer; protects Google quota) ---
# Max requests per window, per client IP.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS ---
# Comma-separated list of origins allowed to call the backend.
# Keep locked down: only Open WebUI / localhost during development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
